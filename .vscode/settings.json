{
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true,
    "editor.rulers": [80, 100, 120],
    "editor.wordWrap": "on",
    "files.exclude": {
        "**/.git": true,
        "**/__pycache__": true,
        "**/*.pyc": true,
        ".pio": true,
        "build": true
    },
    "search.exclude": {
        ".pio": true,
        "build": true,
        ".git": true,
        "firmware": true
    },
    "C_Cpp.default.compileCommands": "${workspaceFolder}/.pio/build/esp8266_debug/compile_commands.json",
    "C_Cpp.intelliSenseEngine": "default",
    "platformio-ide.autoPreloadLibraries": true,
    "platformio-ide.autoUpdateIndexLibraries": true,
    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true,
        "editor.detectIndentation": true
    },
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "markdown.preview.breaks": true,
    "[markdown]": {
        "editor.wordWrap": "on",
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    }
}
